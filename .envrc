# Keep caches off the internal disk. The APFS container on this Mac shares
# space with the home directory and had only 5.3 GB free at project start;
# a toolchain install was enough to fill it and block all shell access.
# Source this before working: `source .envrc`
export UV_CACHE_DIR=/Volumes/ROS2_SSD/RDRK_MVA/.cache/uv
export HOMEBREW_CACHE=/Volumes/ROS2_SSD/.cache/homebrew
export TMPDIR=/Volumes/ROS2_SSD/.tmp
export PATH="/opt/homebrew/bin:$PATH"
